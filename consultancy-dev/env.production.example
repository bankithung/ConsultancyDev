# Production Environment Variables for Next.js
# Copy to .env.production.local on the server

# Backend API URL (change to your Oracle instance IP or domain)
# A trailing slash is optional - lib/api.ts normalises it.
NEXT_PUBLIC_API_URL=http://your-oracle-ip:8000/api/

# Or with domain name:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/

# RSA PUBLIC key used by middleware.ts to verify the JWT signature at the edge.
# Copy the backend's JWT_PUBLIC_KEY_B64 verbatim (base64-encoded PEM; raw PEM
# also works). The backend signs RS256 with the matching PRIVATE key, which
# never leaves it - so this value cannot be used to forge tokens.
# Server-only: do NOT prefix with NEXT_PUBLIC_.
# If unset, role-gated routes fail CLOSED (they redirect to /app/forbidden).
JWT_PUBLIC_KEY_B64=

# DEV-ONLY fallback. The backend signs HS256 with SECRET_KEY only when it has no
# keypair configured, which it permits solely when DEBUG=True. Leave this EMPTY
# in production: a shared symmetric secret would let the frontend mint tokens
# too. Ignored whenever JWT_PUBLIC_KEY_B64 is set.
# JWT_VERIFY_SECRET=

# Application URL
NEXT_PUBLIC_APP_URL=http://your-oracle-ip:3000

# Or with domain:
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
