# Railway Frontend Environment Variables
# Copy these to your Railway frontend service settings

# Backend API URL (use your Railway backend URL)
# A trailing slash is optional - lib/api.ts normalises it.
NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api/

# RSA PUBLIC key used by middleware.ts to verify the JWT signature at the edge.
# Copy the backend's JWT_PUBLIC_KEY_B64 verbatim (base64-encoded PEM).
# The backend signs RS256 with the private half, which never leaves it.
# Server-only: do NOT prefix with NEXT_PUBLIC_.
# If unset, role-gated routes fail CLOSED.
JWT_PUBLIC_KEY_B64=

# DEV-ONLY fallback for a DEBUG backend with no keypair (it then signs HS256
# with SECRET_KEY). Leave EMPTY in production. Ignored if the public key is set.
# JWT_VERIFY_SECRET=

# Frontend URL (use your Railway frontend URL)
NEXT_PUBLIC_APP_URL=https://your-frontend.railway.app
